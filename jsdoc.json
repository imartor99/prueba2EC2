{
    "source": {
        "include": ["js/"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "plugins": [],
    "opts": {
        "encoding": "utf8",
        "destination": "./docs",
        "recurse": true,
        "readme": "README.md",
        "template": "node_modules/minami"
    },
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false
    }
}